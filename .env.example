# ============================================================
# KONFIGURASI MIDTRANS — Warung Sayur Diky
# ============================================================
# SALIN file ini menjadi ".env" lalu isi nilainya.
#   PowerShell:  Copy-Item .env.example .env
#
# PENTING:
#  - MIDTRANS_SERVER_KEY bersifat RAHASIA. Jangan commit .env ke Git.
#  - Selama nilai masih placeholder, sistem berjalan dalam MODE DEMO
#    (transaksi tidak dikirim ke Midtrans, UI tetap bisa diuji).
#
# Ambil nilai di: https://dashboard.midtrans.com
#   Sandbox : menu Settings > Access Keys
#   Produksi: toggle ke Production, lalu Settings > Access Keys
# ============================================================

# Sandbox diawali "SB-Mid-server-..." ; Produksi "Mid-server-..."
MIDTRANS_SERVER_KEY=GANTI_DENGAN_SERVER_KEY

# Client Key (aman diekspos ke browser)
MIDTRANS_CLIENT_KEY=GANTI_DENGAN_CLIENT_KEY

# Merchant ID / ID Toko (opsional)
MIDTRANS_MERCHANT_ID=

# false = Sandbox, true = Produksi
MIDTRANS_IS_PRODUCTION=false

# Port server (opsional, default 3000)
PORT=3000
